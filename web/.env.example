NEXT_PUBLIC_API_URL="http://localhost:4001"
# Tenant sites answer on <subdomain>.<PUBLIC_ROOT_DOMAIN>. lvh.me resolves every
# subdomain to 127.0.0.1, so locally Corrick is http://corrick.lvh.me:3000 (D-030).
PUBLIC_ROOT_DOMAIN="lvh.me"
# Guards /__revalidate, which api calls when a live page changes (CNT-08, D-039).
# Must match REVALIDATE_SECRET in api/.env.
REVALIDATE_SECRET="dev-only-change-me-too"
