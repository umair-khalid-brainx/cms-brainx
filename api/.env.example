# apps/api — local development environment
DATABASE_URL="postgresql://USER@localhost:5432/cms?schema=public"
API_PORT=4000
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
ADMIN_URL="http://localhost:5173"
API_PUBLIC_URL="http://localhost:4001"
UPLOADS_DIR="./uploads"
# Where web takes on-demand ISR refreshes, and the secret both sides share
# (CNT-08, D-039). Same value as REVALIDATE_SECRET in web/.env.local.
WEB_REVALIDATE_URL="http://localhost:3000/__revalidate"
REVALIDATE_SECRET="dev-only-change-me-too"

# Shared with web (FORM_SUBMIT_SECRET there). Only web may submit contact forms (D-034).
# Without it, POST /public/sites/:subdomain/submissions refuses everything.
FORM_SUBMIT_SECRET="dev-only-change-me"
