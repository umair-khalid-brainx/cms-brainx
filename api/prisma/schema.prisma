// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// MVP schema — the minimum needed to log a user in, know which site they
// belong to, and let them save a page's block array through the editor.
// Deliberately excludes: publish-state transitions (CNT-03), page hierarchy +
// path recomputation (CNT-05/CNT-06), custom content types (TYP-*), media,
// SEO, taxonomy, menus, revisions.

model Site {
  id        String   @id @default(cuid())
  // Reserved for real custom domains (DEP-02). The public site is reached by
  // `subdomain` under a per-environment root domain instead — see D-030.
  host      String   @unique
  // `corrick` in `corrick.lvh.me` / `corrick.<root domain>`. Editable by
  // owners and administrators (D-031); the rules live in SitesService.
  subdomain String   @unique
  name      String
  themeJson Json     @default("{}") @map("theme_json")
  // What the public header and footer show besides the name (GOV-04): tagline, footer note and
  // a logo from the site's media library. Shape and rules: sites/site-settings.ts.
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  SiteMembership[]
  content      Content[]
  invites      Invite[]
  media        Media[]
  redirects    Redirect[]
  menuItems    MenuItem[]
  previewLinks PreviewLink[]
  submissions  Submission[]
  contentTypes ContentType[]

  @@map("sites")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships     SiteMembership[]
  sentInvites     Invite[]
  uploadedMedia   Media[]
  authoredContent Content[]
  redirects       Redirect[]

  @@map("users")
}

// The 5 fixed, code-defined roles (GOV-06) — see api/src/auth/permission.ts
// for the permission set each one actually grants. A Prisma enum rather than
// a table: the permission sets are hardcoded and never edited at runtime, so
// a table's only real payoff (an admin UI that edits roles) doesn't exist —
// see DECISIONS.md D-023.
enum Role {
  owner
  administrator
  editor
  author
  contributor

  @@map("member_role")
}

// Ties a user to a site with a role. This is what a JWT's "site memberships"
// claim (ARCHITECTURE.md security model) reads from.
model SiteMembership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@map("site_memberships")
}

// A pending invitation to join a site. No email is ever sent (no email
// infrastructure exists in this repo) — the owner/admin who creates one gets
// a one-time link back to copy and share manually. `tokenHash` is a SHA-256
// hash, not bcrypt: the token is a 256-bit random value with no keyspace to
// brute-force, so bcrypt's deliberate slowness buys nothing, and a fast hash
// supports the O(1) lookup-by-token bcrypt can't do at all.
model Invite {
  id              String    @id @default(cuid())
  siteId          String    @map("site_id")
  email           String
  role            Role
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  site      Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invitedBy User @relation(fields: [invitedByUserId], references: [id])

  @@map("invites")
}

// `archived` is a status, not a separate flag (D-032) — so "is this page
// live?" is one check, `status = published`, with no second column to forget.
enum ContentStatus {
  draft
  published
  archived

  @@map("content_status")
}

// The pages. `blocks` stores the flat `{ type, ...props }` contract defined
// by cms-blocks/types.ts (invariant 7), NOT Puck's native nested shape —
// admin is responsible for translating Puck's ComponentData into this shape
// before it ever reaches the API (see DECISIONS.md D-013 addendum).
model Content {
  id          String        @id @default(cuid())
  siteId      String        @map("site_id")
  title       String
  slug        String
  path        String
  status      ContentStatus @default(draft)
  blocks      Json          @default("[]")
  // Values of the type's custom fields, by field key (TYP-02). Empty for pages.
  data        Json          @default("{}")
  // Search and social-sharing settings (SEO-01): meta title and description, canonical URL,
  // social title, description and image, and noindex. Shape and rules: content/seo.ts.
  // Empty means "use the page's own title and text"; the fallbacks live in public/seo-view.ts.
  seo         Json          @default("{}")
  // When it was archived, for display only — set on entering `archived`,
  // cleared on leaving it. `status` is the source of truth, not this.
  archivedAt  DateTime?     @map("archived_at")
  // When it was first published: the date shown on a public entry, and what a type's listing is
  // ordered by, newest first (TYP-03). Set once; unpublishing doesn't clear it.
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Set for entries of a custom type (events, posts...); null for ordinary pages (TYP-01).
  typeId   String? @map("type_id")
  // Who created it; the public entry header shows it (TYP-03). Null if that user is later removed.
  authorId String? @map("author_id")
  // The page this one sits under (CNT-05): `/about/team` has `/about` as its parent. Pages only,
  // within one site, at most 3 levels deep, never a loop; the rules live in ContentService.
  // `path` is derived from it and recomputed for the whole subtree on a move (CNT-06, invariant 9).
  parentId String? @map("parent_id")

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type        ContentType? @relation(fields: [typeId], references: [id], onDelete: Restrict)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Restrict: a page with children can't be deleted out from under them.
  parent      Content?     @relation("PageTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Content[]    @relation("PageTree")
  previewLink PreviewLink?
  submissions Submission[]
  menuItems   MenuItem[]

  // Matches the actual read pattern (ARCHITECTURE.md: "fetch content by
  // (site_id, path)"). `path` is derived from the parent chain (invariant 9).
  @@unique([siteId, path])
  // Admin routes by slug alone, so a slug is unique across the whole site, pages and
  // entries together (CNT-04). The service checks first; this catches two writes racing.
  @@unique([siteId, slug])
  @@index([siteId, parentId])
  @@map("content")
}

// A kind of content a client defines in the admin without a deploy (TYP-01):
// "Events", "Team", "Case studies". Pages are the typeless default. `prefix`
// is the first segment of every entry's address (`/events/summer-fair`), so it
// is unique per site and locked once the type has entries. The built-in "Posts"
// type (`/blog`) can't be deleted or moved. Fields come with TYP-02.
model ContentType {
  id           String   @id @default(cuid())
  siteId       String   @map("site_id")
  // Plural, shown in the sidebar ("Events"); singular for buttons ("Add Event").
  name         String
  singularName String   @map("singular_name")
  prefix       String
  isBuiltIn    Boolean  @default(false) @map("is_built_in")
  // The fields entries of this type carry (TYP-02): an array of { key, label, kind,
  // required, options? } over six fixed kinds. Removing one hides it; the values
  // stay in each entry's `data`. See content-types/field-definitions.ts.
  fields       Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  site    Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content Content[]

  @@unique([siteId, prefix])
  @@map("content_types")
}

// A row per uploaded file (media.service.ts writes both the file to disk and
// this row, in that order — see MediaService.store). `filename` is the
// stored uuid.ext on disk, never the client's original name (media.service.ts
// never trusts that string). No "used on these pages" column or join table:
// usage is a runtime scan of Content.blocks JSONB (D-044,
// ContentRepository.findReferencing).
model Media {
  id               String   @id @default(cuid())
  siteId           String   @map("site_id")
  url              String
  // Null for files sharp doesn't thumbnail (SVG, GIF, video) and for uploads
  // made before MED-01's thumbnails existed — the library falls back to url.
  thumbnailUrl     String?  @map("thumbnail_url")
  // Library information (MED-04, req. 4). `alt` is the default alternative text for
  // images: a page that leaves its own empty uses it on the live site (D-047).
  // Title and description are for the library only, never shown publicly.
  alt              String?
  title            String?
  description      String?
  filename         String
  mimetype         String
  size             Int
  uploadedByUserId String   @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  site       Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedByUserId], references: [id])

  @@map("media")
}

// One shareable preview link per page (CNT-09): no expiry, lives until
// someone revokes it. `token` is the secret (32 random bytes, base64url).
// It's stored as-is, not hashed, because the editor shows the same link
// again later. `siteId` duplicates the page's own so the public lookup is
// scoped by site (invariant 1): a token used on another site's host matches
// nothing.
model PreviewLink {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  contentId String   @unique @map("content_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("preview_links")
}

// Starter page layouts (TYP-05), offered on page creation (TYP-04). Global,
// shared by every site: platform data like the block registry, not tenant
// content, so there's no `siteId` (D-038). Filled by the seed from
// prisma/starter-layouts.ts, upserted by `key`.
model StarterLayout {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  blocks      Json
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("starter_layouts")
}

// One contact form submission from a public-site visitor (BLK-06, D-034).
// `answers` is an ordered array of `{ name, label, value }`, not an object
// keyed by name: the editor defines each form's fields, JSONB objects don't
// keep key order, and a snapshot of each label keeps old submissions
// readable after the editor renames or removes a field. `pageTitle` and
// `pagePath` are snapshots for the same reason; `contentId` goes null if the
// page is deleted, the submission stays.
model Submission {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  contentId String?  @map("content_id")
  pageTitle String   @map("page_title")
  pagePath  String   @map("page_path")
  answers   Json
  createdAt DateTime @default(now()) @map("created_at")

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@map("submissions")
}

// Where an old address sends visitors (GOV-05). `auto` ones are made when a page that was
// ever published moves (CNT-06); `manual` ones by staff. Never chained: adding B → C
// rewrites A → B to A → C. A page always wins: when a page takes an address, any redirect
// from it goes. The rules live in api/src/redirects/redirect-rules.ts.
enum RedirectSource {
  manual
  auto

  @@map("redirect_source")
}

model Redirect {
  id          String         @id @default(cuid())
  siteId      String         @map("site_id")
  // A path on this site, `/old-page`: lowercase, no trailing slash, no query.
  fromPath    String         @map("from_path")
  // A path on this site, or a full http(s) URL elsewhere.
  toPath      String         @map("to_path")
  source      RedirectSource
  createdById String?        @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  site      Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([siteId, fromPath])
  @@map("redirects")
}

// The two menus of a site (GOV-03): the header's navigation and the footer's link groups.
enum MenuLocation {
  header
  footer

  @@map("menu_location")
}

// One item of a site's menu, at most two levels deep: a top item (`parentId` null) and its children.
// An item is a page (`contentId`, so it follows the page's slug and parent) or a custom link (`url`);
// exactly one of the two. The whole menu is replaced at once on save (api/src/menus).
model MenuItem {
  id        String       @id @default(cuid())
  siteId    String       @map("site_id")
  location  MenuLocation
  parentId  String?      @map("parent_id")
  position  Int
  label     String
  // Cascade: a page deleted for good (only archived pages can be) leaves the menu with it.
  contentId String?      @map("content_id")
  url       String?

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")
  content  Content?   @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([siteId, location, parentId, position])
  @@index([contentId])
  @@map("menu_items")
}
