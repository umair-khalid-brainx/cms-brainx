// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// MVP schema — the minimum needed to log a user in, know which site they
// belong to, and let them save a page's block array through the editor.
// Deliberately excludes: publish-state transitions (CNT-03), page hierarchy +
// path recomputation (CNT-05/CNT-06), custom content types (TYP-*), media,
// SEO, taxonomy, menus, revisions.

model Site {
  id        String   @id @default(cuid())
  // Reserved for real custom domains (DEP-02). The public site is reached by
  // `subdomain` under a per-environment root domain instead — see D-030.
  host      String   @unique
  // `corrick` in `corrick.lvh.me` / `corrick.<root domain>`. Editable by
  // owners and administrators (D-031); the rules live in SitesService.
  subdomain String   @unique
  name      String
  themeJson Json     @default("{}") @map("theme_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  SiteMembership[]
  content      Content[]
  invites      Invite[]
  media        Media[]
  previewLinks PreviewLink[]

  @@map("sites")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   SiteMembership[]
  sentInvites   Invite[]
  uploadedMedia Media[]

  @@map("users")
}

// The 5 fixed, code-defined roles (GOV-06) — see api/src/auth/permission.ts
// for the permission set each one actually grants. A Prisma enum rather than
// a table: the permission sets are hardcoded and never edited at runtime, so
// a table's only real payoff (an admin UI that edits roles) doesn't exist —
// see DECISIONS.md D-023.
enum Role {
  owner
  administrator
  editor
  author
  contributor

  @@map("member_role")
}

// Ties a user to a site with a role. This is what a JWT's "site memberships"
// claim (ARCHITECTURE.md security model) reads from.
model SiteMembership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@map("site_memberships")
}

// A pending invitation to join a site. No email is ever sent (no email
// infrastructure exists in this repo) — the owner/admin who creates one gets
// a one-time link back to copy and share manually. `tokenHash` is a SHA-256
// hash, not bcrypt: the token is a 256-bit random value with no keyspace to
// brute-force, so bcrypt's deliberate slowness buys nothing, and a fast hash
// supports the O(1) lookup-by-token bcrypt can't do at all.
model Invite {
  id              String    @id @default(cuid())
  siteId          String    @map("site_id")
  email           String
  role            Role
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  site      Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invitedBy User @relation(fields: [invitedByUserId], references: [id])

  @@map("invites")
}

// `archived` is a status, not a separate flag (D-032) — so "is this page
// live?" is one check, `status = published`, with no second column to forget.
enum ContentStatus {
  draft
  published
  archived

  @@map("content_status")
}

// The pages. `blocks` stores the flat `{ type, ...props }` contract defined
// by cms-blocks/types.ts (invariant 7), NOT Puck's native nested shape —
// admin is responsible for translating Puck's ComponentData into this shape
// before it ever reaches the API (see DECISIONS.md D-013 addendum).
model Content {
  id         String        @id @default(cuid())
  siteId     String        @map("site_id")
  title      String
  slug       String
  path       String
  status     ContentStatus @default(draft)
  blocks     Json          @default("[]")
  // When it was archived, for display only — set on entering `archived`,
  // cleared on leaving it. `status` is the source of truth, not this.
  archivedAt DateTime?     @map("archived_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  previewLink PreviewLink?

  // Matches the actual read pattern (ARCHITECTURE.md: "fetch content by
  // (site_id, path)"). path === slug for now since hierarchy is deferred.
  @@unique([siteId, path])
  @@map("content")
}

// A row per uploaded file (media.service.ts writes both the file to disk and
// this row, in that order — see MediaService.store). `filename` is the
// stored uuid.ext on disk, never the client's original name (media.service.ts
// never trusts that string). No "used on these pages" tracking — see
// DECISIONS.md D-026: that would need either a join table kept in sync on
// every content save or a runtime scan of Content.blocks JSONB, both real
// added scope, not built here.
model Media {
  id               String   @id @default(cuid())
  siteId           String   @map("site_id")
  url              String
  // Null for files sharp doesn't thumbnail (SVG, GIF, video) and for uploads
  // made before MED-01's thumbnails existed — the library falls back to url.
  thumbnailUrl     String?  @map("thumbnail_url")
  filename         String
  mimetype         String
  size             Int
  uploadedByUserId String   @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  site       Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedByUserId], references: [id])

  @@map("media")
}

// One shareable preview link per page (CNT-09): no expiry, lives until
// someone revokes it. `token` is the secret (32 random bytes, base64url).
// It's stored as-is, not hashed, because the editor shows the same link
// again later. `siteId` duplicates the page's own so the public lookup is
// scoped by site (invariant 1): a token used on another site's host matches
// nothing.
model PreviewLink {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  contentId String   @unique @map("content_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("preview_links")
}

// Starter page layouts (TYP-05), offered on page creation (TYP-04). Global,
// shared by every site: platform data like the block registry, not tenant
// content, so there's no `siteId` (D-038). Filled by the seed from
// prisma/starter-layouts.ts, upserted by `key`.
model StarterLayout {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  blocks      Json
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("starter_layouts")
}
